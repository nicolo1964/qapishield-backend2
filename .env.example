# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limits (slowapi format: "<count>/<period>")
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=1/hour

# Debug Mode (set to False in production)
DEBUG=False

ALLOWED_ORIGINS=["http://localhost:3000","https://3000-io1u5ijrn78vcygxbrnq4-2020ef04.manusvm.computer", "https://app.qapishield.com"]
# Used to build links in verification/password-reset emails
APP_BASE_URL=http://localhost:8000

# Frontend page URLs the token-based emails link to
FRONTEND_VERIFY_EMAIL_URL=http://localhost:3000/verify-email
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_ACCEPT_INVITE_URL=http://localhost:3000/accept-invite

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=True
